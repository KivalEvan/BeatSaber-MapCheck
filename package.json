{
  "name": "map-check",
  "version": "2.7.6",
  "description": "Web application for extensive overview for Beat Saber beatmap.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 8080",
    "check": "tsc",
    "test": "vitest --environment jsdom",
    "format": "prettier --write ./src && prettier --write ./tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KivalEvan/BeatSaber-MapCheck.git"
  },
  "author": "Kival Evan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KivalEvan/BeatSaber-MapCheck/issues"
  },
  "homepage": "https://github.com/KivalEvan/BeatSaber-MapCheck#readme",
  "dependencies": {
    "bsmap": "^2.3.6",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
